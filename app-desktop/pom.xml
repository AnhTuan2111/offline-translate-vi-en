<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anhtuan.dict</groupId>
    <artifactId>offline-translate-vi-en</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app-desktop</artifactId>
  <name>app-desktop</name>
  <description>
    UI JavaFX + Spring Boot non-web. Bat dau tu M5.

    CANH BAO (PLAN.md AD-7): TUYET DOI khong them javafx-web.
    No keo theo WebKit: +35 MB dia, +40 MB RAM. Dung TextFlow de render.
    Kiem tra bang: mvn -pl app-desktop dependency:tree | grep javafx
  </description>

  <dependencies>
    <dependency>
      <groupId>com.anhtuan.dict</groupId>
      <artifactId>dict-core</artifactId>
    </dependency>

    <!-- JavaFX: CHI controls. Khong web, khong media, khong swing. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Spring Boot non-web: chi lay DI + config, KHONG lay starter-web. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Du lieu nguoi dung (lich su, tu da luu). PLAN.md AD-10. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>${sqlite.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.anhtuan.dict.desktop.DictApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
