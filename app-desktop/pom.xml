<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.anhtuan.dict</groupId>
    <artifactId>offline-translate-vi-en</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>app-desktop</artifactId>
  <name>app-desktop</name>
  <description>
    UI JavaFX. KHONG co Spring: AD-8 da duoc sua lai, DI lam bang composition root
    thu cong trong config/AppContext.java (ly do ghi ngay trong javadoc cua class do).

    CANH BAO (PLAN.md AD-7): TUYET DOI khong them javafx-web.
    No keo theo WebKit: +35 MB dia, +40 MB RAM. Dung TextFlow de render.
    Kiem tra bang: mvn -pl app-desktop dependency:tree | grep javafx
  </description>

  <dependencies>
    <dependency>
      <groupId>com.anhtuan.dict</groupId>
      <artifactId>dict-core</artifactId>
    </dependency>

    <!-- JavaFX: CHI controls. Khong web, khong media, khong swing. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- KHONG co dependency nao khac. Toan bo app chi gom: dict-core (0 dep) + JavaFX.
         sqlite-jdbc se duoc them lai o M6 khi thuc su can luu lich su nguoi dung. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.anhtuan.dict.desktop.DictApp</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
